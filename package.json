{
  "name": "sc-crm-comercial",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 4173",
    "check": "node --check assets/js/app.js && node --check assets/js/agents.js && node --check scripts/create-users.mjs",
    "lint": "npm run check && npm run lint:html",
    "lint:html": "html-validate index.html agents.html",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "users:create": "node scripts/create-users.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "html-validate": "11.16.1"
  }
}
