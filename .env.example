SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=NO_SUBIR_ESTA_CLAVE

# Secrets para Supabase Edge Functions. Configurarlos en el servidor, nunca en el navegador.
OPENAI_API_KEY=
OPENAI_ACCOUNT_LABEL=SC Produccion
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=
OPENAI_ALLOWED_MODELS=gpt-6-luna,gpt-6-sol,gpt-6-astra,gpt-5.4-mini,gpt-5-mini
OPENAI_PROSPECTING_MODEL=gpt-5-mini
OPENAI_QUOTE_MODEL=gpt-5-mini
RESEND_API_KEY=
RESEND_FROM=SC Gestion <notificaciones@example.com>
RESEND_REPLY_TO=
ALLOWED_ORIGINS=https://erp.scsolucionesconectadas.com.ar,http://127.0.0.1:4173

SC_ORGANIZATION_NAME=Soluciones Conectadas
SC_ORGANIZATION_SLUG=soluciones-conectadas
SC_DEFAULT_CURRENCY=ARS

# Contraseñas iniciales. No subir .env a Git.
SC_PASSWORD_MBETANCOURT=
SC_PASSWORD_AREYES=
SC_PASSWORD_OROJAS=
