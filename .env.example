SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=NO_SUBIR_ESTA_CLAVE

# Secrets para Supabase Edge Functions. Configurarlos en el servidor, nunca en el navegador.
# CHATGPT_CLIENT_ID requiere aprobacion de OpenAI para Sign in with ChatGPT.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_TOKEN_AUTH_METHOD=none
CHATGPT_REDIRECT_URI=https://rcvzfzuisnactwepvcup.supabase.co/functions/v1/chatgpt-oauth/callback
# Clave aleatoria de 32 bytes codificada en base64url, sin padding.
CHATGPT_TOKEN_ENCRYPTION_KEY=
CHATGPT_AGENT_HOST_ID=
RESEND_API_KEY=
RESEND_FROM=SC Gestion <notificaciones@example.com>
RESEND_REPLY_TO=
ALLOWED_ORIGINS=https://erp.scsolucionesconectadas.com.ar,http://127.0.0.1:4173

SC_ORGANIZATION_NAME=Soluciones Conectadas
SC_ORGANIZATION_SLUG=soluciones-conectadas
SC_DEFAULT_CURRENCY=ARS

# Contraseñas iniciales. No subir .env a Git.
SC_PASSWORD_MBETANCOURT=
SC_PASSWORD_AREYES=
SC_PASSWORD_OROJAS=
